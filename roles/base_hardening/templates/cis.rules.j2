#jinja2: trim_blocks: True, lstrip_blocks: True
## {{ ansible_managed }}
## CIS 4.1.3 — audit rules. Loaded by augenrules(8) from /etc/audit/rules.d/.

## Remove any rules inherited from a previous load.
-D

## Kernel backlog. 8192 is the CIS recommendation; too small and events are lost
## under load, which shows up as "audit: backlog limit exceeded" in dmesg.
-b 8192
-f 1
--backlog_wait_time 60000

## ---------------------------------------------------------------------------
## 4.1.3.1 — changes to date and time
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k time-change
-w /etc/localtime -p wa -k time-change

## ---------------------------------------------------------------------------
## 4.1.3.2 — user and group information
## ---------------------------------------------------------------------------
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/nsswitch.conf -p wa -k identity
-w /etc/pam.conf -p wa -k identity
-w /etc/pam.d -p wa -k identity

## ---------------------------------------------------------------------------
## 4.1.3.3 — network environment
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale
-a always,exit -F arch=b32 -S sethostname,setdomainname -k system-locale
-w /etc/issue -p wa -k system-locale
-w /etc/issue.net -p wa -k system-locale
-w /etc/hosts -p wa -k system-locale
-w /etc/hostname -p wa -k system-locale

## ---------------------------------------------------------------------------
## 4.1.3.4 — MAC policy
## ---------------------------------------------------------------------------
{% if ansible_os_family == 'RedHat' %}
-w /etc/selinux -p wa -k MAC-policy
-w /usr/share/selinux -p wa -k MAC-policy
{% else %}
-w /etc/apparmor -p wa -k MAC-policy
-w /etc/apparmor.d -p wa -k MAC-policy
{% endif %}

## ---------------------------------------------------------------------------
## 4.1.3.5-7 — logins, session initiation, sudo
## ---------------------------------------------------------------------------
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock -p wa -k logins
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session
-w /etc/sudoers -p wa -k scope
-w /etc/sudoers.d -p wa -k scope
-w /var/log/sudo.log -p wa -k actions

## ---------------------------------------------------------------------------
## 4.1.3.8 — discretionary access control changes
## The uid filter excludes system daemons; auid!=unset excludes kernel threads.
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat,chown,fchown,fchownat,lchown -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat,chown,fchown,fchownat,lchown -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k perm_mod

## ---------------------------------------------------------------------------
## 4.1.3.9 — unsuccessful file access attempts
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k access
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k access
-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k access
-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k access

## ---------------------------------------------------------------------------
## 4.1.3.10 — mounts
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S mount -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k mounts
-a always,exit -F arch=b32 -S mount -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k mounts

## ---------------------------------------------------------------------------
## 4.1.3.11 — file deletion by users
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k delete
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k delete

## ---------------------------------------------------------------------------
## 4.1.3.13 — kernel module loading
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid>={{ base_hardening_uid_min }} -F auid!=4294967295 -k modules
-w /usr/bin/kmod -p x -k modules

## ---------------------------------------------------------------------------
## 4.1.3.14 — privileged command execution
## The real CIS check enumerates every setuid binary found by a find(1) sweep.
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k privileged
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k privileged
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k privileged
-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k privileged

{% if base_hardening_auditd_immutable %}
## ---------------------------------------------------------------------------
## 4.1.3.20 — make the configuration immutable.
## A reboot is required to change rules after this point.
## ---------------------------------------------------------------------------
-e 2
{% else %}
## Rules are mutable (-e 1). Set base_hardening_auditd_immutable=true in production;
## CIS 4.1.3.20 requires -e 2, which needs a reboot to undo.
-e 1
{% endif %}
