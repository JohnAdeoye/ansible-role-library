#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}

user {{ nginx_user }};
worker_processes {{ nginx_worker_processes }};
worker_rlimit_nofile {{ nginx_worker_rlimit_nofile }};
pid {{ nginx_pid_file }};
error_log {{ nginx_error_log }} {{ nginx_error_log_level }};

events {
    worker_connections {{ nginx_worker_connections }};
    multi_accept on;
}

http {
    include {{ nginx_conf_dir }}/mime.types;
    default_type application/octet-stream;

    # --- Logging ----------------------------------------------------------
    log_format {{ nginx_log_format_name }} {{ nginx_log_format }};
    access_log {{ nginx_access_log }} {{ nginx_log_format_name }};

    # --- Connection handling ----------------------------------------------
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ nginx_keepalive_timeout }};
    types_hash_max_size 4096;
    client_max_body_size {{ nginx_client_max_body_size }};

    # Do not advertise the NGINX version in headers or error pages.
    server_tokens {{ nginx_server_tokens }};

    # Slowloris mitigation: a client that dawdles over headers or body gets dropped.
    client_body_timeout 12;
    client_header_timeout 12;
    send_timeout 10;

    # --- Compression -------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/xml
        text/css
        text/plain
        text/xml
        image/svg+xml;

    # --- Rate limiting zones ----------------------------------------------
    {% for zone in nginx_rate_limit_zones %}
    limit_req_zone {{ zone.key }} zone={{ zone.name }}:{{ zone.size }} rate={{ zone.rate }};
    {% endfor %}
    {% for zone in nginx_connection_limit_zones %}
    limit_conn_zone {{ zone.key }} zone={{ zone.name }}:{{ zone.size }};
    {% endfor %}

    # Return 429 rather than the default 503 — it is the correct status and
    # clients back off on it.
    limit_req_status 429;
    limit_conn_status 429;

    # --- WebSocket upgrade helper -----------------------------------------
    # `map` is only valid in http context, so it lives here rather than in the
    # proxy-params snippet that gets included at location level.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    include {{ nginx_conf_dir }}/conf.d/*.conf;
    include {{ nginx_conf_dir }}/sites-enabled/*.conf;

    {% if nginx_status_enabled %}
    # --- Metrics endpoint for prometheus nginx-exporter -------------------
    # Bound to loopback: the exporter runs on the host, nothing external needs this.
    server {
        listen 127.0.0.1:{{ nginx_status_port }};
        server_name _;
        access_log off;

        location /stub_status {
            stub_status;
            {% for cidr in nginx_status_allow %}
            allow {{ cidr }};
            {% endfor %}
            deny all;
        }
    }
    {% endif %}
}
