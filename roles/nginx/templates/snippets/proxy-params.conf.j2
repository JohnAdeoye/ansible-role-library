# {{ ansible_managed }}
# Shared reverse-proxy parameters.

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Port $server_port;

proxy_http_version 1.1;

# Let the backend own its own error pages rather than swallowing them.
proxy_intercept_errors off;

proxy_connect_timeout {{ nginx_proxy_connect_timeout | default('5s') }};
proxy_send_timeout {{ nginx_proxy_send_timeout | default('60s') }};
proxy_read_timeout {{ nginx_proxy_read_timeout | default('60s') }};

proxy_buffering on;
proxy_buffer_size 8k;
proxy_buffers 8 8k;

# Do not pass the upstream's own hop-by-hop headers through.
proxy_hide_header X-Powered-By;
