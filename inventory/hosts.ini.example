# Copy to hosts.ini and adjust. hosts.ini itself is gitignored so real hostnames
# and addresses do not end up in version control.

[rhel]
rhel-app-01 ansible_host=10.10.20.11
rhel-app-02 ansible_host=10.10.20.12

[ubuntu]
ubu-web-01 ansible_host=10.10.20.21
ubu-web-02 ansible_host=10.10.20.22

[web]
ubu-web-01
ubu-web-02

[all:vars]
ansible_user=ansible
ansible_ssh_private_key_file=~/.ssh/id_ed25519
